<mxfile host="app.diagrams.net" version="24.0.0" type="device">

  <diagram id="calls" name="1 · Where a model is called">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ttl" value="Where a model is called" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Six calls. Everything after step 4 is deterministic code." style="text;html=1;fontSize=13;align=left;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="600" height="22" as="geometry" />
        </mxCell>
        <mxCell id="k1" value="model" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1130" y="24" width="70" height="24" as="geometry" />
        </mxCell>
        <mxCell id="k2" value="code" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1210" y="24" width="70" height="24" as="geometry" />
        </mxCell>
        <mxCell id="k3" value="guard" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="24" width="70" height="24" as="geometry" />
        </mxCell>

        <!-- 1 OCR -->
        <mxCell id="s1" value="1 · OCR" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="&lt;b&gt;Vision model&lt;/b&gt;&#10;prompt · v15_prompt()&#10;&quot;transcribe, don't interpret&quot;&#10;tables as HTML&#10;in · page images 1800px, ≤ 8&#10;out · text + table markup" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="240" height="115" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="&lt;b&gt;Engine&lt;/b&gt; · switchable live&#10;ollama · Typhoon OCR 1.5 3B&#10;typhoon_api · cloud&#10;openai · claude · vision&#10;pdftext · text layer, no model&#10;tesseract · fallback" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="115" width="230" height="115" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="&lt;b&gt;Quality score&lt;/b&gt;&#10;character mix · line shape&#10;→ every field's confidence&#10;→ marks the run degraded" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="570" y="115" width="220" height="85" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="Local Ollama runs on its native API — the OpenAI-compatible one ignores keep_alive and num_ctx, and a 4k window makes the model transcribe a page it can no longer see." style="text;html=1;fontSize=10;fontStyle=2;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="820" y="115" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="o1" target="o3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 2 classify -->
        <mxCell id="s2" value="2 · Classify" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="255" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;Keywords first&lt;/b&gt; · code&#10;distinctive words per type&#10;confident → no model call" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;Classifier&lt;/b&gt; · only when unsure&#10;CLASSIFIER_SYSTEM&#10;in · first ~2k characters&#10;out · {doc_type, confidence}" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="280" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;→ DocumentSchema&lt;/b&gt;&#10;invoice · receipt · PO · contract · form&#10;fields, aliases, choices&#10;required / critical flags" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="570" y="280" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 3 extract -->
        <mxCell id="s3" value="3 · Extract — twice, blind to each other" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="375" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="x1" value="&lt;b&gt;Channel 1 · field-first&lt;/b&gt;&#10;EXTRACTION_SYSTEM&#10;&quot;copy exactly · never calculate&#10;never infer · not found → null&#10;every value needs its quote&quot;&#10;in · schema + OCR text&#10;out · {field: value, evidence}" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="x2" value="&lt;b&gt;Channel 2 · label-first&lt;/b&gt;&#10;VERIFY_SYSTEM&#10;&quot;find the label, take what&#10;sits beside it&quot;&#10;same shape, different route&#10;in · schema + OCR text&#10;out · {field: value, evidence}" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="400" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="x3" value="&lt;b&gt;Rules for channel 2&lt;/b&gt;&#10;· a different backend from ch1&#10;· never the one hosting OCR&#10;· 90 second budget&#10;· timeout → deterministic&#10;  label matcher instead" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="570" y="400" width="230" height="115" as="geometry" />
        </mxCell>
        <mxCell id="x4" value="Two runs of one model repeat the same mistake — the agreement signal is then worth nothing. Sharing a backend with OCR evicts the vision model: 40s became 10 minutes." style="text;html=1;fontSize=10;fontStyle=2;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="820" y="400" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="x3" target="x2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- divider -->
        <mxCell id="div" value="" style="line;strokeWidth=2;html=1;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="1060" height="10" as="geometry" />
        </mxCell>
        <mxCell id="divl" value="no model below this line" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#b85450;align=left;" vertex="1" parent="1">
          <mxGeometry x="900" y="528" width="200" height="20" as="geometry" />
        </mxCell>

        <!-- 4 merge -->
        <mxCell id="s4" value="4 · Merge and ground" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="575" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="&lt;b&gt;Normalise&lt;/b&gt;&#10;dates → YYYY-MM-DD&#10;  Buddhist era, Thai digits&#10;  day-first from parts &gt; 12&#10;money → float&#10;enums → schema aliases" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="240" height="115" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;Ground the quote&lt;/b&gt;&#10;1 · is it on the page?&#10;  fuzzy ≥ 88 — OCR noise&#10;  is not a lie&#10;2 · does it state the value?&#10;  dates as dates, sums as sums" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="600" width="230" height="115" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="&lt;b&gt;Score the field&lt;/b&gt;&#10;both agree 0.97&#10;one channel, grounded 0.86&#10;disagree 0.45&#10;one channel, ungrounded 0.30&#10;× OCR quality" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="570" y="600" width="230" height="115" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="&lt;b&gt;Currency, if unstated&lt;/b&gt;&#10;symbol on the page → grounded&#10;else vendor's default&#10;else the issuing country&#10;inferred → cannot auto-post" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="830" y="600" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="&lt;b&gt;Corroboration&lt;/b&gt; · two channels agreeing, both quotes real on the page ⇒ grounded.  ·  An ungrounded critical field never auto-posts." style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="722" width="1020" height="20" as="geometry" />
        </mxCell>

        <!-- 5 validate -->
        <mxCell id="s5" value="5 · Validate" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="765" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="v1" value="&lt;b&gt;26 built-in rules&lt;/b&gt;&#10;arithmetic · dates&#10;master data · duplicates&#10;three-way match&#10;tax IDs · bank accounts" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="&lt;b&gt;Your rules&lt;/b&gt;&#10;compiled once from a prompt&#10;stored as a condition tree&#10;evaluated by code, no eval&#10;a model never runs them" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="790" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="&lt;b&gt;Four switches&lt;/b&gt; · persisted&#10;free mode → nothing runs&#10;built-ins off → yours only&#10;disabled_rules → by id&#10;severity → re-grade, not silence" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="570" y="790" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="&lt;b&gt;Each switch leaves a mark&lt;/b&gt;&#10;a record that was not checked&#10;must not look like one that was&#10;&#10;a rule that raises → a warning,&#10;never a stopped validation" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="830" y="790" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- 6 route -->
        <mxCell id="s6" value="6 · Route" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="915" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;Auto-post needs all four&lt;/b&gt;&#10;· no blocking rule failed&#10;· confidence ≥ threshold&#10;· every required field present&#10;· every critical field grounded" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="940" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;Reconciler&lt;/b&gt; · model, page 3&#10;runs only when a check failed&#10;— nothing on the happy path&#10;explains, never edits" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="940" width="230" height="85" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;Post&lt;/b&gt; · the only write to the ledger&#10;refuses anything not cleared,&#10;unless a reviewer approved it" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="570" y="940" width="230" height="85" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="r1" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="pipeline" name="2 · Pipeline and the human loop">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p0" />
        <mxCell id="p1" parent="p0" />

        <mxCell id="pt" value="Pipeline" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="p1">
          <mxGeometry x="40" y="20" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="psub" value="Every stage writes to the run's trace. A failure degrades the run and sends it to a person — it never raises." style="text;html=1;fontSize=13;align=left;fontColor=#555555;" vertex="1" parent="p1">
          <mxGeometry x="40" y="50" width="800" height="22" as="geometry" />
        </mxCell>

        <mxCell id="q" value="&lt;b&gt;Batch queue&lt;/b&gt;&#10;1 worker on a local engine, 4 on cloud&#10;≤ 50 files per batch" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p1">
          <mxGeometry x="440" y="90" width="280" height="65" as="geometry" />
        </mxCell>

        <mxCell id="g0" value="&lt;b&gt;ingest&lt;/b&gt; · upload, URL or sample → content-addressed blob" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p1">
          <mxGeometry x="40" y="100" width="360" height="42" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="&lt;b&gt;render&lt;/b&gt; · PDFium → images (single-threaded: two at once segfaults)" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p1">
          <mxGeometry x="40" y="155" width="360" height="42" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="&lt;b&gt;ocr&lt;/b&gt; · vision model" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p1">
          <mxGeometry x="40" y="210" width="360" height="36" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="&lt;b&gt;classify&lt;/b&gt; · keywords, then a model if unsure" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p1">
          <mxGeometry x="40" y="259" width="360" height="36" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="&lt;b&gt;extract&lt;/b&gt; · two channels, then merge and ground (code)" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p1">
          <mxGeometry x="40" y="308" width="360" height="36" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="&lt;b&gt;line_items&lt;/b&gt; · table rows from HTML or plain text" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p1">
          <mxGeometry x="40" y="357" width="360" height="36" as="geometry" />
        </mxCell>
        <mxCell id="g6" value="&lt;b&gt;validate&lt;/b&gt; · master data + rules&#10;vendor match: tax ID → name → alias → fuzzy ≥ 86" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;" vertex="1" parent="p1">
          <mxGeometry x="40" y="406" width="360" height="52" as="geometry" />
        </mxCell>
        <mxCell id="g7" value="&lt;b&gt;route&lt;/b&gt; · post, hold, or refuse" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p1">
          <mxGeometry x="40" y="471" width="360" height="36" as="geometry" />
        </mxCell>
        <mxCell id="g8" value="&lt;b&gt;reconcile&lt;/b&gt; · agent, only if something failed" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p1">
          <mxGeometry x="40" y="520" width="360" height="36" as="geometry" />
        </mxCell>
        <mxCell id="g9" value="&lt;b&gt;archive&lt;/b&gt; · hard link into archive/&lt;type&gt;/&lt;month&gt;/" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="p1">
          <mxGeometry x="40" y="569" width="360" height="36" as="geometry" />
        </mxCell>
        <mxCell id="g10" value="&lt;b&gt;post&lt;/b&gt; · the ledger" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="p1">
          <mxGeometry x="40" y="618" width="360" height="36" as="geometry" />
        </mxCell>

        <mxCell id="pe0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="p1" source="g0" target="g1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="p1" source="g1" target="g2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="p1" source="g2" target="g3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="p1" source="g3" target="g4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="p1" source="g4" target="g5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="p1" source="g5" target="g6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="p1" source="g6" target="g7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="p1" source="g7" target="g8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="p1" source="g8" target="g9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="p1" source="g9" target="g10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="p1" source="q" target="g0"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- human loop -->
        <mxCell id="hl" value="The human loop" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="p1">
          <mxGeometry x="500" y="200" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="&lt;b&gt;Review queue&lt;/b&gt;&#10;the page beside every field, its quote,&#10;every rule that ran, the agent's account" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p1">
          <mxGeometry x="500" y="228" width="330" height="62" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="&lt;b&gt;Save&lt;/b&gt; · keeps the values, re-runs the rules,&#10;leaves the decision where it was.&#10;An edit, not a verdict." style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p1">
          <mxGeometry x="500" y="305" width="330" height="62" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="&lt;b&gt;Re-check&lt;/b&gt; · re-judges under today's policy&#10;no render, no OCR, no model call&#10;7 documents in 25 ms" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p1">
          <mxGeometry x="500" y="382" width="330" height="62" as="geometry" />
        </mxCell>
        <mxCell id="h4" value="&lt;b&gt;Approve &amp; post&lt;/b&gt; · refused while a blocking&#10;rule still fails. Fix the value or reject —&#10;there is no way past a failing check." style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p1">
          <mxGeometry x="500" y="459" width="330" height="62" as="geometry" />
        </mxCell>
        <mxCell id="h5" value="&lt;b&gt;Re-check refuses two things&lt;/b&gt;&#10;· a document a person rejected — a policy&#10;  change is not consent to overturn them&#10;· a posted document — that is a credit note,&#10;  not a re-run" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p1">
          <mxGeometry x="880" y="382" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="ph1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="p1" source="g7" target="h1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ph2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="p1" source="h1" target="h2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ph3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="p1" source="h2" target="h3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ph4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="p1" source="h3" target="h4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ph5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="p1" source="h4" target="g10"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="store" value="&lt;b&gt;What is kept&lt;/b&gt; · the whole run, as JSON&#10;OCR text · every field with its quote and confidence&#10;every rule result · every stage and how long it took&#10;&#10;→ any decision reconstructable months later&#10;→ re-judged without reading the page again" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p1">
          <mxGeometry x="40" y="690" width="420" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="agents" name="3 · Agents and tools">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="a0" />
        <mxCell id="a1" parent="a0" />

        <mxCell id="at" value="Agents" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="a1">
          <mxGeometry x="40" y="20" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="asb" value="Three places a model does more than read. None of them can change a stored value." style="text;html=1;fontSize=13;align=left;fontColor=#555555;" vertex="1" parent="a1">
          <mxGeometry x="40" y="50" width="700" height="22" as="geometry" />
        </mxCell>

        <!-- reconciler -->
        <mxCell id="r0" value="RECONCILER · runs only after a check has failed" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="a1">
          <mxGeometry x="40" y="90" width="500" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;Prompt&lt;/b&gt; · RECONCILER_SYSTEM&#10;&quot;verify with tools before you conclude&#10;never assert what a tool has not confirmed&#10;propose a correction only if the page shows it&#10;otherwise say so and recommend review&quot;&#10;&#10;&lt;b&gt;Given&lt;/b&gt; · doc type · every field with its&#10;confidence, ungrounded ones marked&#10;· every failed check and its message&#10;&#10;&lt;b&gt;Loop&lt;/b&gt; · ≤ 6 rounds · temperature 0" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="a1">
          <mxGeometry x="40" y="115" width="300" height="200" as="geometry" />
        </mxCell>

        <mxCell id="t0" value="&lt;b&gt;Seven tools · all read-only&lt;/b&gt;" style="text;html=1;fontSize=11;fontStyle=1;align=left;" vertex="1" parent="a1">
          <mxGeometry x="370" y="115" width="260" height="18" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="read_document · what the page says" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="a1">
          <mxGeometry x="370" y="137" width="290" height="26" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="lookup_vendor" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="a1">
          <mxGeometry x="370" y="167" width="290" height="26" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="lookup_purchase_order" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="a1">
          <mxGeometry x="370" y="197" width="290" height="26" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="lookup_contract" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="a1">
          <mxGeometry x="370" y="227" width="290" height="26" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="find_posted_records · confirm a duplicate" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="a1">
          <mxGeometry x="370" y="257" width="290" height="26" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="check_arithmetic · it never adds up itself" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="a1">
          <mxGeometry x="370" y="287" width="290" height="26" as="geometry" />
        </mxCell>
        <mxCell id="t7" value="validate_tax_id" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="a1">
          <mxGeometry x="370" y="317" width="290" height="26" as="geometry" />
        </mxCell>

        <mxCell id="rg" value="&lt;b&gt;Every suggestion is re-grounded&lt;/b&gt;&#10;· the field must exist in the schema&#10;· the quote must be on the page (≥ 88)&#10;· the quote must state the proposed value&#10;&#10;Fails any → shown unverified, cannot apply.&#10;&#10;Seen on a real invoice: it proposed replacing&#10;the subtotal — the one change that would have&#10;made the arithmetic pass — and was refused." style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="a1">
          <mxGeometry x="700" y="115" width="320" height="185" as="geometry" />
        </mxCell>
        <mxCell id="ae1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;" edge="1" parent="a1" source="r1" target="t3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="a1" source="t1" target="rg"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- authoring -->
        <mxCell id="w0" value="RULE AUTHORING · the model compiles a rule once, then never runs it" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="a1">
          <mxGeometry x="40" y="380" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="&lt;b&gt;1 · plain language&lt;/b&gt;&#10;&quot;invoices over 100,000 must&#10;quote a purchase order&quot;" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="a1">
          <mxGeometry x="40" y="405" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="&lt;b&gt;2 · compiled to JSON&lt;/b&gt;&#10;{when, assert, severity}&#10;`assert` = what must be true&#10;retried once with the&#10;validator's own error" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="a1">
          <mxGeometry x="290" y="405" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="&lt;b&gt;3 · validated&lt;/b&gt;&#10;no eval · depth ≤ 8&#10;known fields only&#10;a test that can never fail&#10;is refused" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="a1">
          <mxGeometry x="540" y="405" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="&lt;b&gt;4 · previewed&lt;/b&gt;&#10;replayed over documents&#10;already processed, before&#10;it is saved" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="a1">
          <mxGeometry x="790" y="405" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="w5" value="&lt;b&gt;5 · saved · plain code from here on&lt;/b&gt;&#10;always answers to exactly what the author approved, and keeps running when the built-in rules are switched off" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="a1">
          <mxGeometry x="1040" y="405" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="we1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="a1" source="w1" target="w2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="we2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="a1" source="w2" target="w3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="we3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="a1" source="w3" target="w4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="we4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="a1" source="w4" target="w5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- briefing -->
        <mxCell id="b0" value="BRIEFING · the model writes the note, never the facts" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="a1">
          <mxGeometry x="40" y="550" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;1 · the agenda is computed&lt;/b&gt; · SQL&#10;payments due · contracts expiring&#10;purchase orders never billed&#10;counterparties whose documents stick" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="a1">
          <mxGeometry x="40" y="575" width="300" height="85" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;2 · the model ranks it&lt;/b&gt; · no tools&#10;&quot;never state a number, name or date&#10;that is not in the items given to you&#10;cite ids in square brackets&quot;" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="a1">
          <mxGeometry x="370" y="575" width="300" height="85" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;3 · citations checked back&lt;/b&gt;&#10;an id not on the agenda is dropped&#10;and the drop reported&#10;every item links to its document" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="a1">
          <mxGeometry x="700" y="575" width="300" height="85" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;What this cannot catch&lt;/b&gt;&#10;real ids in a wrong relationship.&#10;Seen once: two POs grouped under&#10;one supplier when they belong to two.&#10;The computed facts sit beside the prose,&#10;so the page contradicts it where it matters." style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="a1">
          <mxGeometry x="1030" y="575" width="310" height="110" as="geometry" />
        </mxCell>
        <mxCell id="be1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="a1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="a1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="foot" value="A model may read, look up, propose and explain. It is never the thing that decides a value is correct." style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="a1">
          <mxGeometry x="40" y="720" width="900" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
