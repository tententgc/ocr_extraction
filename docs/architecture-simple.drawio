        </mxCell>
        <mxCell id="foot" parent="a1" style="text;html=1;fontSize=13;fontStyle=1;align=left;" value="A model may read, look up, propose and explain. It is never the thing that decides a value is correct." vertex="1">
          <mxGeometry height="24" width="900" x="40" y="720" as="geometry" />
        </mxCell>
