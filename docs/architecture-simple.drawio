        <mxCell id="f10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;exitX=0;exitY=0.5;" edge="1" parent="1" source="n11" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f12" value="failed a check" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1" source="n6" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="&lt;b&gt;Why twice?&lt;/b&gt;&#10;Two models read the page without seeing each&#10;other's answer. Agreeing is evidence. Disagreeing&#10;drops the confidence and a person looks.&#10;&#10;&lt;b&gt;Why the quote?&lt;/b&gt;&#10;Every value carries the line it was read from. If&#10;that line is not on the page, the value is not used.&#10;&#10;&lt;b&gt;What posts on its own?&lt;/b&gt;&#10;Only a document with no failing rule, high&#10;confidence, every required field, and every&#10;important value traceable to the page." style="rounded=0;html=1;fillColor=#fafafa;strokeColor=#cccccc;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="110" width="320" height="290" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

