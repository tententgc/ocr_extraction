        </mxCell>
        <mxCell id="h1" parent="p1" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;Review queue&lt;/b&gt;&#xa;the page beside every field, its quote,&#xa;every rule that ran, the agent&#39;s account" vertex="1">
