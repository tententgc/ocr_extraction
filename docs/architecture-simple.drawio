        </mxCell>
        <mxCell id="divl" parent="1" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#b85450;align=left;" value="no model below this line" vertex="1">
          <mxGeometry height="20" width="200" x="900" y="528" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=left;" value="4 · Merge and ground" vertex="1">
          <mxGeometry height="20" width="300" x="40" y="575" as="geometry" />
        </mxCell>
        <mxCell id="m1" parent="1" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;Normalise&lt;/b&gt;&#xa;dates → YYYY-MM-DD&#xa;  Buddhist era, Thai digits&#xa;  day-first from parts &gt; 12&#xa;money → float&#xa;enums → schema aliases" vertex="1">
          <mxGeometry height="115" width="240" x="40" y="600" as="geometry" />
        </mxCell>
        <mxCell id="m2" parent="1" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;Ground the quote&lt;/b&gt;&#xa;1 · is it on the page?&#xa;  fuzzy ≥ 88 — OCR noise&#xa;  is not a lie&#xa;2 · does it state the value?&#xa;  dates as dates, sums as sums" vertex="1">
          <mxGeometry height="115" width="230" x="310" y="600" as="geometry" />
        </mxCell>
        <mxCell id="m3" parent="1" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;Score the field&lt;/b&gt;&#xa;both agree 0.97&#xa;one channel, grounded 0.86&#xa;disagree 0.45&#xa;one channel, ungrounded 0.30&#xa;× OCR quality" vertex="1">
          <mxGeometry height="115" width="230" x="570" y="600" as="geometry" />
        </mxCell>
        <mxCell id="m4" parent="1" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;Currency, if unstated&lt;/b&gt;&#xa;symbol on the page → grounded&#xa;else vendor&#39;s default&#xa;else the issuing country&#xa;inferred → cannot auto-post" vertex="1">
          <mxGeometry height="100" width="230" x="830" y="600" as="geometry" />
        </mxCell>
        <mxCell id="m5" parent="1" style="text;html=1;fontSize=11;align=left;" value="&lt;b&gt;Corroboration&lt;/b&gt; · two channels agreeing, both quotes real on the page ⇒ grounded.  ·  An ungrounded critical field never auto-posts." vertex="1">
          <mxGeometry height="20" width="1020" x="40" y="722" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=left;" value="5 · Validate" vertex="1">
          <mxGeometry height="20" width="300" x="40" y="765" as="geometry" />
        </mxCell>
        <mxCell id="v1" parent="1" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;26 built-in rules&lt;/b&gt;&#xa;arithmetic · dates&#xa;master data · duplicates&#xa;three-way match&#xa;tax IDs · bank accounts" vertex="1">
          <mxGeometry height="100" width="240" x="40" y="790" as="geometry" />
        </mxCell>
        <mxCell id="v2" parent="1" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;Your rules&lt;/b&gt;&#xa;compiled once from a prompt&#xa;stored as a condition tree&#xa;evaluated by code, no eval&#xa;a model never runs them" vertex="1">
          <mxGeometry height="100" width="230" x="310" y="790" as="geometry" />
        </mxCell>
        <mxCell id="v3" parent="1" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;Four switches&lt;/b&gt; · persisted&#xa;free mode → nothing runs&#xa;built-ins off → yours only&#xa;disabled_rules → by id&#xa;severity → re-grade, not silence" vertex="1">
          <mxGeometry height="100" width="230" x="570" y="790" as="geometry" />
        </mxCell>
        <mxCell id="v4" parent="1" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;Each switch leaves a mark&lt;/b&gt;&#xa;a record that was not checked&#xa;must not look like one that was&#xa;&#xa;a rule that raises → a warning,&#xa;never a stopped validation" vertex="1">
          <mxGeometry height="100" width="230" x="830" y="790" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=left;" value="6 · Route" vertex="1">
          <mxGeometry height="20" width="300" x="40" y="915" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="1" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;Auto-post needs all four&lt;/b&gt;&#xa;· no blocking rule failed&#xa;· confidence ≥ threshold&#xa;· every required field present&#xa;· every critical field grounded" vertex="1">
          <mxGeometry height="100" width="240" x="40" y="940" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="1" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;Reconciler&lt;/b&gt; · model, page 3&#xa;runs only when a check failed&#xa;— nothing on the happy path&#xa;explains, never edits" vertex="1">
          <mxGeometry height="85" width="230" x="310" y="940" as="geometry" />
        </mxCell>
        <mxCell id="r3" parent="1" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;Post&lt;/b&gt; · the only write to the ledger&#xa;refuses anything not cleared,&#xa;unless a reviewer approved it" vertex="1">
          <mxGeometry height="85" width="230" x="570" y="940" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="r1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" target="r3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
