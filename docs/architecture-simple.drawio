        <mxCell id="b0" parent="a1" style="text;html=1;fontSize=14;fontStyle=1;align=left;" value="BRIEFING · the model writes the note, never the facts" vertex="1">
          <mxGeometry height="20" width="600" x="40" y="550" as="geometry" />
        </mxCell>
        <mxCell id="b1" parent="a1" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;1 · the agenda is computed&lt;/b&gt; · SQL&#xa;payments due · contracts expiring&#xa;purchase orders never billed&#xa;counterparties whose documents stick" vertex="1">
          <mxGeometry height="85" width="300" x="40" y="575" as="geometry" />
        </mxCell>
        <mxCell id="b2" parent="a1" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;2 · the model ranks it&lt;/b&gt; · no tools&#xa;&quot;never state a number, name or date&#xa;that is not in the items given to you&#xa;cite ids in square brackets&quot;" vertex="1">
          <mxGeometry height="85" width="300" x="370" y="575" as="geometry" />
        </mxCell>
        <mxCell id="b3" parent="a1" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;3 · citations checked back&lt;/b&gt;&#xa;an id not on the agenda is dropped&#xa;and the drop reported&#xa;every item links to its document" vertex="1">
          <mxGeometry height="85" width="300" x="700" y="575" as="geometry" />
        </mxCell>
        <mxCell id="b4" parent="a1" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;What this cannot catch&lt;/b&gt;&#xa;real ids in a wrong relationship.&#xa;Seen once: two POs grouped under&#xa;one supplier when they belong to two.&#xa;The computed facts sit beside the prose,&#xa;so the page contradicts it where it matters." vertex="1">
          <mxGeometry height="110" width="310" x="1030" y="575" as="geometry" />
        </mxCell>
