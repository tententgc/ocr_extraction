        <mxCell id="w0" parent="a1" style="text;html=1;fontSize=14;fontStyle=1;align=left;" value="RULE AUTHORING · the model compiles a rule once, then never runs it" vertex="1">
          <mxGeometry height="20" width="700" x="40" y="380" as="geometry" />
        </mxCell>
        <mxCell id="w1" parent="a1" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;1 · plain language&lt;/b&gt;&#xa;&quot;invoices over 100,000 must&#xa;quote a purchase order&quot;" vertex="1">
          <mxGeometry height="70" width="220" x="40" y="405" as="geometry" />
        </mxCell>
        <mxCell id="w2" parent="a1" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;2 · compiled to JSON&lt;/b&gt;&#xa;{when, assert, severity}&#xa;`assert` = what must be true&#xa;retried once with the&#xa;validator&#39;s own error" vertex="1">
          <mxGeometry height="90" width="220" x="290" y="405" as="geometry" />
        </mxCell>
        <mxCell id="w3" parent="a1" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;3 · validated&lt;/b&gt;&#xa;no eval · depth ≤ 8&#xa;known fields only&#xa;a test that can never fail&#xa;is refused" vertex="1">
          <mxGeometry height="90" width="220" x="540" y="405" as="geometry" />
        </mxCell>
        <mxCell id="w4" parent="a1" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;4 · previewed&lt;/b&gt;&#xa;replayed over documents&#xa;already processed, before&#xa;it is saved" vertex="1">
          <mxGeometry height="90" width="220" x="790" y="405" as="geometry" />
        </mxCell>
        <mxCell id="w5" parent="a1" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;5 · saved · plain code from here on&lt;/b&gt;&#xa;always answers to exactly what the author approved, and keeps running when the built-in rules are switched off" vertex="1">
          <mxGeometry height="90" width="300" x="1040" y="405" as="geometry" />
        </mxCell>
