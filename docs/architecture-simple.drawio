  <diagram name="3 · Agents and tools" id="bwjxtp9HjYeCTPbbaywf">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="a0" />
        <mxCell id="a1" parent="a0" />
        <mxCell id="at" parent="a1" style="text;html=1;fontSize=22;fontStyle=1;align=left;" value="Agents" vertex="1">
          <mxGeometry height="30" width="400" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="asb" parent="a1" style="text;html=1;fontSize=13;align=left;fontColor=#555555;" value="Three places a model does more than read. None of them can change a stored value." vertex="1">
          <mxGeometry height="22" width="700" x="40" y="50" as="geometry" />
        </mxCell>
        <mxCell id="r0" parent="a1" style="text;html=1;fontSize=14;fontStyle=1;align=left;" value="RECONCILER · runs only after a check has failed" vertex="1">
          <mxGeometry height="20" width="500" x="40" y="90" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="a1" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;Prompt&lt;/b&gt; · RECONCILER_SYSTEM&#xa;&quot;verify with tools before you conclude&#xa;never assert what a tool has not confirmed&#xa;propose a correction only if the page shows it&#xa;otherwise say so and recommend review&quot;&#xa;&#xa;&lt;b&gt;Given&lt;/b&gt; · doc type · every field with its&#xa;confidence, ungrounded ones marked&#xa;· every failed check and its message&#xa;&#xa;&lt;b&gt;Loop&lt;/b&gt; · ≤ 6 rounds · temperature 0" vertex="1">
          <mxGeometry height="200" width="300" x="40" y="115" as="geometry" />
        </mxCell>
        <mxCell id="t0" parent="a1" style="text;html=1;fontSize=11;fontStyle=1;align=left;" value="&lt;b&gt;Seven tools · all read-only&lt;/b&gt;" vertex="1">
          <mxGeometry height="18" width="260" x="370" y="115" as="geometry" />
        </mxCell>
        <mxCell id="t1" parent="a1" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" value="read_document · what the page says" vertex="1">
          <mxGeometry height="26" width="290" x="370" y="137" as="geometry" />
        </mxCell>
        <mxCell id="t2" parent="a1" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" value="lookup_vendor" vertex="1">
          <mxGeometry height="26" width="290" x="370" y="167" as="geometry" />
        </mxCell>
        <mxCell id="t3" parent="a1" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" value="lookup_purchase_order" vertex="1">
          <mxGeometry height="26" width="290" x="370" y="197" as="geometry" />
        </mxCell>
        <mxCell id="t4" parent="a1" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" value="lookup_contract" vertex="1">
          <mxGeometry height="26" width="290" x="370" y="227" as="geometry" />
        </mxCell>
        <mxCell id="t5" parent="a1" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" value="find_posted_records · confirm a duplicate" vertex="1">
          <mxGeometry height="26" width="290" x="370" y="257" as="geometry" />
        </mxCell>
        <mxCell id="t6" parent="a1" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" value="check_arithmetic · it never adds up itself" vertex="1">
          <mxGeometry height="26" width="290" x="370" y="287" as="geometry" />
        </mxCell>
        <mxCell id="t7" parent="a1" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" value="validate_tax_id" vertex="1">
          <mxGeometry height="26" width="290" x="370" y="317" as="geometry" />
        </mxCell>
        <mxCell id="rg" parent="a1" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;Every suggestion is re-grounded&lt;/b&gt;&#xa;· the field must exist in the schema&#xa;· the quote must be on the page (≥ 88)&#xa;· the quote must state the proposed value&#xa;&#xa;Fails any → shown unverified, cannot apply.&#xa;&#xa;Seen on a real invoice: it proposed replacing&#xa;the subtotal — the one change that would have&#xa;made the arithmetic pass — and was refused." vertex="1">
          <mxGeometry height="185" width="320" x="700" y="115" as="geometry" />
        </mxCell>
