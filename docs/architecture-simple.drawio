          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="afoot" value="A model may read, look up, propose and explain. It is never the thing that decides a value is correct." style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="a1">
