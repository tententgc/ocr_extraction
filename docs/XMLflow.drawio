        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-77" edge="1" parent="1" source="lyHSd0rqOyQ5DavD7wUt-69" style="html=1;endArrow=blockThin;endFill=1;endSize=5;strokeColor=#0F7B4F;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="lyHSd0rqOyQ5DavD7wUt-70">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-78" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF9F0;strokeColor=#9A6400;strokeWidth=2;dashed=1;align=left;spacingLeft=20;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size:19px&quot; color=&quot;#14181F&quot;&gt;&lt;b&gt;Reviewer&lt;/b&gt;&lt;/font&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#3D4757&quot;&gt;&amp;nbsp;&amp;nbsp;sees the page beside the values, the rule that fired and the evidence for each field. Every correction is recorded against the field and the vendor, so the system knows where it is weakest.&lt;/font&gt;" vertex="1">
          <mxGeometry height="72" width="1542" x="60" y="592" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-79" edge="1" parent="1" source="lyHSd0rqOyQ5DavD7wUt-71" style="html=1;endArrow=blockThin;endFill=1;endSize=5;strokeColor=#9A6400;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;rounded=1;" target="lyHSd0rqOyQ5DavD7wUt-78">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1745" y="628" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-80" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#14181F;fontFamily=Helvetica;" value="Four decisions that shape the whole system" vertex="1">
          <mxGeometry height="32" width="700" x="60" y="706" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-81" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE3EC;strokeWidth=2;align=left;spacingLeft=18;spacingTop=6;verticalAlign=top;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size:17px&quot; color=&quot;#14181F&quot;&gt;&lt;b&gt;Two channels, two backends&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;line-height:160%&quot; color=&quot;#3D4757&quot;&gt;A second reading is only worth something if it can fail differently from the first.&lt;/font&gt;" vertex="1">
          <mxGeometry height="128" width="432" x="60" y="750" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-82" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE3EC;strokeWidth=2;align=left;spacingLeft=18;spacingTop=6;verticalAlign=top;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size:17px&quot; color=&quot;#14181F&quot;&gt;&lt;b&gt;Confidence ≠ permission&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;line-height:160%&quot; color=&quot;#3D4757&quot;&gt;&lt;i&gt;Did we read it correctly&lt;/i&gt; and &lt;i&gt;may it post&lt;/i&gt; are different questions. Merged once, three advisory notes took a perfectly-read invoice from 95% to 72%.&lt;/font&gt;" vertex="1">
          <mxGeometry height="128" width="432" x="516" y="750" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-83" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE3EC;strokeWidth=2;align=left;spacingLeft=18;spacingTop=6;verticalAlign=top;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size:17px&quot; color=&quot;#14181F&quot;&gt;&lt;b&gt;Three severities, three behaviours&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;line-height:160%&quot;&gt;&lt;font color=&quot;#B3261E&quot;&gt;&lt;b&gt;Blocking&lt;/b&gt; stops the document.&lt;/font&gt; &lt;font color=&quot;#9A6400&quot;&gt;&lt;b&gt;Warning&lt;/b&gt; is recorded and holds nothing.&lt;/font&gt; &lt;font color=&quot;#4A5568&quot;&gt;&lt;b&gt;Info&lt;/b&gt; is a note.&lt;/font&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="128" width="432" x="972" y="750" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-84" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE3EC;strokeWidth=2;align=left;spacingLeft=18;spacingTop=6;verticalAlign=top;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size:17px&quot; color=&quot;#14181F&quot;&gt;&lt;b&gt;The two errors cost differently&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;line-height:160%&quot; color=&quot;#3D4757&quot;&gt;A missed defect is a wrong payment. A false alarm is a wasted minute. They are never added into one number.&lt;/font&gt;" vertex="1">
          <mxGeometry height="128" width="432" x="1428" y="750" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-85" parent="1" style="line;strokeWidth=2;html=1;strokeColor=#DCE3EC;" value="" vertex="1">
          <mxGeometry height="10" width="1800" x="60" y="912" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-86" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#667085&quot;&gt;&lt;b&gt;READ&lt;/b&gt;&amp;nbsp;&amp;nbsp;Typhoon OCR 1.5&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;AGENTS&lt;/b&gt;&amp;nbsp;&amp;nbsp;Typhoon + Claude, pluggable&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;STORE&lt;/b&gt;&amp;nbsp;&amp;nbsp;SQLite&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;SERVE&lt;/b&gt;&amp;nbsp;&amp;nbsp;FastAPI + web review queue&lt;/font&gt;" vertex="1">
          <mxGeometry height="24" width="1300" x="60" y="936" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-87" parent="1" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#667085&quot;&gt;Thai and English documents · Buddhist-era dates · Thai numerals&lt;/font&gt;" vertex="1">
          <mxGeometry height="24" width="500" x="1360" y="936" as="geometry" />
        </mxCell>
