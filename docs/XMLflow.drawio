          <mxGeometry height="52" width="900" x="60" y="52" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-61" parent="1" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#667085;fontFamily=Helvetica;" value="Unstructured documents in, validated ledger records out" vertex="1">
          <mxGeometry height="28" width="900" x="60" y="106" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-62" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#1F3A5F;strokeWidth=2;align=left;spacingLeft=20;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#667085&quot;&gt;THE METRIC THAT MATTERS&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:21px&quot; color=&quot;#14181F&quot;&gt;&lt;b&gt;Silent error rate&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#667085&quot;&gt;documents that posted automatically&lt;br&gt;carrying a wrong critical value&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="440" x="1420" y="46" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-63" parent="1" style="line;strokeWidth=2;html=1;strokeColor=#DCE3EC;" value="" vertex="1">
          <mxGeometry height="10" width="1800" x="60" y="168" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-64" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2E0;strokeWidth=2;align=left;spacingLeft=18;spacingTop=8;verticalAlign=top;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F3A5F&quot;&gt;&lt;b&gt;01&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot; color=&quot;#14181F&quot;&gt;&lt;b&gt;Ingest&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;line-height:170%&quot; color=&quot;#3D4757&quot;&gt;PDF, JPG, PNG, TIFF&lt;br&gt;Upload, URL or folder&lt;br&gt;Pages rendered to images&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#9A6400&quot;&gt;A long PDF read short must say so —&lt;br&gt;nothing downstream can miss a page&lt;br&gt;it was never shown&lt;/font&gt;" vertex="1">
          <mxGeometry height="316" width="286" x="60" y="234" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-65" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2E0;strokeWidth=2;align=left;spacingLeft=18;spacingTop=8;verticalAlign=top;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F3A5F&quot;&gt;&lt;b&gt;02&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot; color=&quot;#14181F&quot;&gt;&lt;b&gt;Prepare&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;line-height:170%&quot; color=&quot;#3D4757&quot;&gt;Measure the page first&lt;br&gt;Lighting, skew, contrast&lt;br&gt;Re-measure after each fix&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#0F7B4F&quot;&gt;&lt;b&gt;Every correction must prove itself&lt;/b&gt;&lt;br&gt;If the metric did not improve, the&lt;br&gt;change is thrown away&lt;/font&gt;" vertex="1">
          <mxGeometry height="316" width="286" x="374" y="234" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-66" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2E0;strokeWidth=2;align=left;spacingLeft=18;spacingTop=8;verticalAlign=top;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F3A5F&quot;&gt;&lt;b&gt;03&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot; color=&quot;#14181F&quot;&gt;&lt;b&gt;Read&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;line-height:170%&quot; color=&quot;#3D4757&quot;&gt;Typhoon OCR 1.5&lt;br&gt;Tables kept as structure&lt;br&gt;Document type classified&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#B3261E&quot;&gt;Text that comes back confidently&lt;br&gt;wrong scores as well as text that&lt;br&gt;comes back right&lt;/font&gt;" vertex="1">
          <mxGeometry height="316" width="286" x="688" y="234" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-67" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#1F3A5F;strokeWidth=2;align=left;spacingLeft=18;spacingTop=8;verticalAlign=top;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F3A5F&quot;&gt;&lt;b&gt;04&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot; color=&quot;#14181F&quot;&gt;&lt;b&gt;Extract&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;line-height:170%&quot; color=&quot;#3D4757&quot;&gt;&lt;b&gt;Two agents read the page&lt;/b&gt;&lt;br&gt;Each must cite its evidence&lt;br&gt;Normalise, then compare&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F3A5F&quot;&gt;&lt;b&gt;Different backends, not two passes&lt;/b&gt;&lt;br&gt;One model read twice repeats its&lt;br&gt;own mistake — and agrees with it&lt;/font&gt;" vertex="1">
          <mxGeometry height="316" width="286" x="1002" y="234" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-68" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#1F3A5F;strokeWidth=2;align=left;spacingLeft=18;spacingTop=8;verticalAlign=top;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F3A5F&quot;&gt;&lt;b&gt;05&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot; color=&quot;#14181F&quot;&gt;&lt;b&gt;Verify&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;line-height:170%&quot; color=&quot;#3D4757&quot;&gt;26 rules recompute totals&lt;br&gt;Checked against the register&lt;br&gt;Agent rules with 8 tools&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F3A5F&quot;&gt;&lt;b&gt;Models read and fetch.&lt;br&gt;Rules decide.&lt;/b&gt;&lt;br&gt;A rule written as a sentence is still&lt;br&gt;enforced by the engine, not the model&lt;/font&gt;" vertex="1">
          <mxGeometry height="316" width="286" x="1316" y="234" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-69" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3A5F;strokeWidth=3;align=left;spacingLeft=18;spacingTop=8;verticalAlign=top;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F3A5F&quot;&gt;&lt;b&gt;06&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot; color=&quot;#14181F&quot;&gt;&lt;b&gt;Decide&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;line-height:165%&quot; color=&quot;#3D4757&quot;&gt;No blocking failure&lt;br&gt;Critical values grounded&lt;br&gt;Confidence ≥ threshold&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="230" x="1630" y="234" as="geometry" />
        </mxCell>
        <mxCell id="lyHSd0rqOyQ5DavD7wUt-70" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E3F5EC;strokeColor=#0F7B4F;strokeWidth=2;fontColor=#0F7B4F;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;POST&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#3D4757&quot;&gt;straight through, no review&lt;/font&gt;" vertex="1">
          <mxGeometry height="54" width="230" x="1630" y="434" as="geometry" />
        </mxCell>
