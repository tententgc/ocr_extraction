# ---------------------------------------------------------------------------
# DocuFlow configuration. Copy to .env and edit.
#   cp .env.example .env
#
# Secrets belong ONLY in .env (git-ignored) - never in source.
# The demo runs fully offline with the defaults below; no key is required.
# ---------------------------------------------------------------------------

# === OCR ENGINE ============================================================
# Which engine reads the page. Also switchable live from the UI dropdown.
#   ollama       on-device Typhoon OCR 1.5 via Ollama (recommended, no key)
#   local        on-device Typhoon OCR 1.5 via MLX (Apple Silicon, no key)
#   typhoon_api  Typhoon Cloud OCR (fastest, needs TYPHOON_API_KEY)
#   openai       OpenAI vision (needs OPENAI_API_KEY)
#   claude       Claude vision (needs ANTHROPIC_API_KEY)
#   pdftext      PDF text layer only, no model
#   tesseract    offline fallback
#   auto         typhoon_api if a key exists, else ollama
OCR_PROVIDER=ollama
OCR_MAX_PAGES=8
OCR_IMAGE_DIM=1800
OCR_MAX_TOKENS=8192

# Straighten, relight and sharpen each page before the model reads it. Every
# correction is gated on a measurement and reverted if it did not help, so a
# clean digital PDF passes through untouched; this is here for the photographs
# and the faxes. Turn it off only to measure an OCR engine on raw input.
OCR_PREPROCESS=true

# === AGENT MODEL ===========================================================
# Classifies, extracts and reconciles. Tool calling is used when supported.
#   auto | ollama | typhoon | openai | claude | local | rules
# "rules" disables the model entirely and runs deterministic extraction only.
LLM_PROVIDER=auto

# The second, independent reading that every value is cross-checked against.
#   auto  pick a backend different from the primary (never the one hosting OCR)
#   off   single channel only - agreement stops being measured
LLM_VERIFY_PROVIDER=auto
LLM_VERIFY_MODEL=
# Time budget for that second reading. Past this the run cross-checks against
# the deterministic label matcher instead of waiting: a local reasoning model
# can spend minutes on a page the first pass read in seconds.
LLM_VERIFY_TIMEOUT_SECONDS=90

# === TYPHOON (opentyphoon.ai) ==============================================
TYPHOON_API_KEY=
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
OCR_CLOUD_MODEL=typhoon-ocr-v1.5
LLM_CLOUD_MODEL=typhoon-v2.5-30b-a3b-instruct

# === OLLAMA (local, no key) ================================================
#   ollama pull scb10x/typhoon-ocr1.5-3b
#   ollama pull qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434/v1
OCR_OLLAMA_MODEL=scb10x/typhoon-ocr1.5-3b
LLM_OLLAMA_MODEL=qwen3:4b
# How long Ollama holds a model in memory after the last call. Its own default
# is 5m, so in a demo nearly every document pays a cold model load: 168s on a
# first-ever load against ~10s once the model is resident.
OLLAMA_KEEP_ALIVE=30m
# Context window for local OCR. The page image alone costs ~3,100 tokens and
# Ollama's default window is 4096 - too little for a dense page, and when it
# overruns the model keeps transcribing a page it can no longer see.
OLLAMA_NUM_CTX=8192
# Load the local models when the server starts rather than on the first upload.
OLLAMA_PRELOAD=true

# === OPENAI ================================================================
# https://platform.openai.com/api-keys
# `docuflow models` lists what your key can actually reach.
OPENAI_API_KEY=
# Leave blank for the official endpoint; set for Azure or a compatible proxy.
OPENAI_BASE_URL=
OCR_OPENAI_MODEL=gpt-5.1
LLM_OPENAI_MODEL=gpt-5.1

# === ANTHROPIC / CLAUDE ====================================================
# https://console.anthropic.com/settings/keys
# OCR runs on every page, so favour the balanced model there; the agent runs
# only when a check has already failed, so it can afford the strongest one.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OCR_ANTHROPIC_MODEL=claude-sonnet-5
LLM_ANTHROPIC_MODEL=claude-opus-5

# === MLX (Apple Silicon, no key) ===========================================
OCR_LOCAL_MODEL=mlx-community/typhoon-ocr1.5-2b-8bit
LLM_LOCAL_MODEL=tawankri/typhoon2.5-qwen3-4b-mlx-4Bit

# === ROUTING THRESHOLDS (accuracy controls) ================================
# At or above AUTO_POST_MIN_CONFIDENCE with no blocking rule failure, a
# document posts downstream automatically. Everything else queues for a human.
AUTO_POST_MIN_CONFIDENCE=0.90
FIELD_REVIEW_CONFIDENCE=0.75

# Two tolerances, answering two different questions. Do not merge them.
#
# How far an invoice may differ from the PURCHASE ORDER it quotes. A commercial
# allowance - freight, a part shipment, a price that moved between order and
# delivery - and 2% of a large order is real money by design.
AMOUNT_TOLERANCE=0.02
# How far a document may differ from ITSELF. Subtotal plus tax either makes the
# total or the document is wrong; the only slack is rounding. Lending the
# commercial allowance to this let an 810-baht misread post as "totals add up"
# on a 200,000-baht invoice.
ARITHMETIC_TOLERANCE=0.0001

# === BUSINESS POLICY (finance rules, not code) =============================
PO_REQUIRED_ABOVE=50000
EXPECTED_VAT_RATES=0,7
# Document types where an unregistered counterparty BLOCKS posting. A receipt
# records money already spent and an onboarding form exists because the
# applicant is not registered yet, so neither belongs here.
UNKNOWN_VENDOR_BLOCKS=invoice,purchase_order
CONTRACT_EXPIRY_WARNING_DAYS=90
MAX_CONTRACT_YEARS=25
FUTURE_DATE_TOLERANCE_DAYS=2
USE_LETTERHEAD_HEURISTIC=true

# === RULE EXECUTION ========================================================
# Free mode: extraction only. No rule runs, nothing is cross-checked against
# master data, and nothing can block - routing falls back to how well the page
# was read (confidence, completeness, grounding). Use it to explore arbitrary
# documents that were never going to match a master file. Do NOT use it for a
# run whose records anyone intends to trust: every result is marked
# "business_rules_disabled" precisely because it was not validated.
RULES_FREE_MODE=false
# The middle setting: switch off the checks that ship with the system while the
# rules you wrote from the Settings screen keep running. Our rules encode a
# generic finance policy; if yours is different, keep your own checks without
# also being told what we think about VAT rates. Unlike listing every rule id in
# DISABLED_RULES, this keeps meaning the same thing after a release adds a rule.
BUILTIN_RULES_DISABLED=false
# Safer middle ground - switch off individual checks and keep the rest working.
# Use the rule ids shown in the UI. Whatever is listed here is what the Settings
# page returns to when someone presses "Reset to .env defaults".
#
# The usual three to switch off first are the ones that fail because a record is
# *absent from the master file*, rather than because anything on the page is
# wrong - which is what happens when real documents meet a demo register:
#
#   vendor_known           the counterparty is not in the vendor master file
#   po_exists              "Purchase order PO-1234 does not exist in the system"
#   contract_matches_master  the contract number is not in the contract register
#
# The neighbouring lookups need no such treatment: po_amount_within_tolerance,
# po_currency_matches, vendor_active and bank_account_matches_vendor all skip
# quietly when there is no record to compare against. Note that
# purchase_order_required is a different thing again - it fails when the
# *document* quotes no PO at all, which is a fact about the page.
#
#   DISABLED_RULES=vendor_known,po_exists,contract_matches_master
DISABLED_RULES=


# === MASTER DATA ===========================================================
# Vendors, purchase orders and contracts: a copy of what the ERP, the
# procurement system and the contract register hold, so documents have
# something to be checked against. Load your own with:
#   docuflow master import vendors.csv --type vendors
#   docuflow master template --type purchase_orders   # the expected columns
# or from Insights -> Master data in the UI. Rows upsert on their natural key,
# so re-importing tomorrow's export corrects rows rather than duplicating them.
#
# The bundled demo register (5 vendors, 4 POs, 2 contracts) is only ever seeded
# into an *empty* master file, so importing your own replaces it for good. Set
# this false to keep it out entirely, including after `docuflow master clear`.
SEED_DEMO_MASTER_DATA=true

# === INGEST ================================================================
# Fetching documents from public URLs (private/loopback ranges are blocked).
ALLOW_URL_FETCH=true
MAX_DOCUMENT_BYTES=26214400
